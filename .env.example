ANTHROPIC_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# Optional: live bus GPS from Modeshift (/transport/vehicles answers 401 without it; positions are then estimated from the timetable)
MODESHIFT_API_KEY=

# Routing (POST /api/route). The default router is the FOSSGIS Valhalla public server: one request per second at most, and its
# policy wants a User-Agent that identifies the app. Put a contact (site URL or email) here; it is appended to the User-Agent.
ROUTER_CONTACT=
# Optional: with a key, OpenRouteService (avoid_polygons) answers when Valhalla is down. Free keys: openrouteservice.org
ORS_API_KEY=

# Place search (GET /api/places). Photon, then Nominatim, geocode real Skopje places (also uses ROUTER_CONTACT in its User-Agent).
# Optional: another Photon server (default https://photon.komoot.io, a demo server: host your own before real traffic).
PHOTON_URL=
